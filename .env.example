# Copy to .env and fill in as needed

# Server (Render sets PORT automatically)
LINK_VAULT_HOST=127.0.0.1
LINK_VAULT_PORT=8787
LINK_VAULT_DB=./data/link_vault.db

# Required on public deploy (Render). Leave empty for local dev.
LINK_VAULT_API_KEY=
LINK_VAULT_PUBLIC_URL=https://your-app.onrender.com

# Optional: enable AI summaries and smarter bucketing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: AMD internal LLM (see llm_template.py in parent repo)
# LLM_BASE_URL=https://llm-api.amd.com/OnPrem
# LLM_API_KEY=
# LLM_MODEL=GPT-oss-20B
# LLM_USER=
