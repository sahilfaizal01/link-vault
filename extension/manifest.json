{
  "manifest_version": 3,
  "name": "Link Vault",
  "description": "Save LinkedIn posts, blogs, and articles into AI-organized buckets.",
  "version": "0.1.0",
  "action": {
    "default_title": "Save to Link Vault",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"]
}
